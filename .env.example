# Desenvolvimento por túnel SSH:
# DATABASE_URL=postgresql://diagnostico_clima_app:SENHA@127.0.0.1:5433/diagnostico_clima?sslmode=disable
# Produção na rede Docker:
DATABASE_URL=postgresql://diagnostico_clima_app:SENHA@postgres-main:5432/diagnostico_clima
HOST=0.0.0.0
PORT=3000
MINIMUM_SAMPLE_SIZE=5
AI_PROVIDER=disabled
AI_API_KEY=
# Exigido apenas se alguém decidir inserir a demonstração em NODE_ENV=production.
# DEMO_SEED_CONFIRM=YES
